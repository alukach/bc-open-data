{
  "version": 8,
  "name": "Fire year",
  "sources": {
    "wildfire-incidents": {
      "type": "vector",
      "url": "pmtiles://../wildfire-incidents.pmtiles",
      "minzoom": 0,
      "maxzoom": 13
    }
  },
  "layers": [
    {
      "id": "wildfire-incidents-circle",

{
  "version": 8,
  "name": "Aquifer material",
  "sources": {
    "aquifers": {
      "type": "vector",
      "url": "pmtiles://../aquifers.pmtiles",
      "minzoom": 0,
      "maxzoom": 13
    }
  },
  "layers": [
    {
      "id": "aquifers-fill",

          [
            "get",
            "MATERIAL"
          ],
          "Sand and Gravel",
          "#8c510a",
          "Bedrock",
          "#d8b365",
          "#b0b0b0"
        ],
        "fill-opacity": 0.6,
        "fill-outline-color": "#ffffff"
      }
    }
  ]
}

{
  "version": 8,
  "name": "Park class",
  "sources": {
    "parks": {
      "type": "vector",
      "url": "pmtiles://../parks.pmtiles",
      "minzoom": 0,
      "maxzoom": 13
    }
  },
  "layers": [
    {
      "id": "parks-fill",
      "type": "fill",
      "source": "parks",
      "source-layer": "parks",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "PARK_CLASS"
          ],
          "Class A",
          "#8c510a",
          "Class C",
          "#d8b365",
          "Class B",
          "#5ab4ac",
          "#b0b0b0"
        ],
        "fill-opacity": 0.6,
        "fill-outline-color": "#ffffff"
      }
    }
  ]
}
